{
  "name": "flexireport",
  "version": "2.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "extract": "lingui extract",
    "start": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "package": "tauri build",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "bump": "node scripts/bump-version.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rm -rf dist node_modules/.vite && pnpm i"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@formkit/auto-animate": "^0.10.0",
    "@lingui/core": "^6.8.0",
