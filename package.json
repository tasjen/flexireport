  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
